<div class="illuminus-export-dialog">

  <p class="hint">{{localize "ILLUMINUS.Export.Hint"}}</p>

  {{!-- Said every time, not only the first: the notice can be dismissed, but
        what an export carries is a fact worth keeping in front of someone. --}}
  <p class="illuminus-export-dialog__carrying hint">
    <i class="fa-solid fa-circle-info"></i>
    {{carrying}}
    <button type="button" class="illuminus-link-button" data-action="terms">
      {{localize "ILLUMINUS.Export.TermsButton"}}
    </button>
  </p>

  <fieldset>
    <legend>{{localize "ILLUMINUS.Export.StyleLegend"}}</legend>
    <select name="styleId">
      {{#each styles as |style|}}
      {{#if style.selected}}
      <option value="{{style.id}}" selected>{{style.name}}</option>
      {{else}}
      <option value="{{style.id}}">{{style.name}}</option>
      {{/if}}
      {{/each}}
    </select>
    <label class="illuminus-export-dialog__option">
      <input type="checkbox" name="onlyStyled" checked>
      <span>{{localize "ILLUMINUS.Export.OnlyStyled"}}</span>
    </label>
  </fieldset>

  <fieldset>
    <legend>{{localize "ILLUMINUS.Export.JournalsLegend"}}</legend>

    <div class="illuminus-export-dialog__tools">
      <button type="button" data-action="pickAll">{{localize "ILLUMINUS.Manager.SelectAll"}}</button>
      <button type="button" data-action="pickNone">{{localize "ILLUMINUS.Export.SelectNone"}}</button>
    </div>

    {{#if journals.length}}
    <div class="illuminus-export-dialog__list scrollable">
      {{#each journals as |journal|}}
      <label class="illuminus-export-dialog__row" data-style-id="{{journal.styleId}}">
        {{#if journal.selected}}
        <input type="checkbox" name="entryIds" value="{{journal.id}}" checked>
        {{else}}
        <input type="checkbox" name="entryIds" value="{{journal.id}}">
        {{/if}}
        <span class="illuminus-export-dialog__name">{{journal.name}}</span>
        <span class="illuminus-export-dialog__pages">{{journal.pages}}</span>
      </label>
      {{/each}}
    </div>
    {{else}}
    <p class="illuminus-manager__empty">{{localize "ILLUMINUS.Export.NoJournals"}}</p>
    {{/if}}
    <p class="illuminus-export-dialog__none hint">{{localize "ILLUMINUS.Export.NoneInStyle"}}</p>
  </fieldset>

  <fieldset>
    <legend>{{localize "ILLUMINUS.Export.FormatLegend"}}</legend>
    {{#each formats as |format|}}
    <label class="illuminus-export-dialog__option">
      {{#if format.checked}}
      <input type="radio" name="format" value="{{format.id}}" checked>
      {{else}}
      <input type="radio" name="format" value="{{format.id}}">
      {{/if}}
      <span>
        {{localize format.label}}
      </span>
    </label>
    {{/each}}
  </fieldset>

  <fieldset>
    <legend>{{localize "ILLUMINUS.Export.OptionsLegend"}}</legend>
    <label class="illuminus-export-dialog__option">
      <input type="checkbox" name="secrets">
      <span>
        {{localize "ILLUMINUS.Export.Secrets"}}
      </span>
    </label>
    <label class="illuminus-export-dialog__option illuminus-export-dialog__pdf-only">
      <input type="checkbox" name="pageBackground">
      <span>
        {{localize "ILLUMINUS.Export.PageTexture"}}
      </span>
    </label>
  </fieldset>
</div>
