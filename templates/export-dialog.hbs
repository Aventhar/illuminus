<div class="illuminus-export-dialog">

  <p class="hint">{{localize "ILLUMINUS.Export.Hint"}}</p>

  {{!-- Said every time, not only the first: the notice can be dismissed, but
        what an export carries is a fact worth keeping in front of someone. --}}
  <p class="illuminus-export-dialog__carrying hint">
    <i class="fa-solid fa-circle-info"></i>
    {{carrying}}
    <button type="button" class="illuminus-link-button" data-action="terms">
      {{localize "ILLUMINUS.Export.TermsButton"}}
    </button>
  </p>

  <fieldset>
    <legend>{{localize "ILLUMINUS.Export.StyleLegend"}}</legend>
    <select name="styleId">
      {{#each styles as |style|}}
      {{#if style.selected}}
      <option value="{{style.id}}" selected>{{style.name}}</option>
      {{else}}
      <option value="{{style.id}}">{{style.name}}</option>
      {{/if}}
      {{/each}}
    </select>
    <label class="illuminus-export-dialog__option">
      <input type="checkbox" name="onlyStyled" checked>
      <span>{{localize "ILLUMINUS.Export.OnlyStyled"}}</span>
    </label>
  </fieldset>

  <fieldset>
    <legend>{{localize "ILLUMINUS.Export.JournalsLegend"}}</legend>

    <div class="illuminus-export-dialog__tools">
      <button type="button" data-action="pickAll">{{localize "ILLUMINUS.Manager.SelectAll"}}</button>
      <button type="button" data-action="pickNone">{{localize "ILLUMINUS.Export.SelectNone"}}</button>
    </div>

    {{#if journals.length}}
    <div class="illuminus-export-dialog__list scrollable">
      {{#each journals as |journal|}}
      <label class="illuminus-export-dialog__row" data-style-id="{{journal.styleId}}">
        {{#if journal.selected}}
        <input type="checkbox" name="entryIds" value="{{journal.id}}" checked>
        {{else}}
        <input type="checkbox" name="entryIds" value="{{journal.id}}">
        {{/if}}
        <span class="illuminus-export-dialog__name">{{journal.name}}</span>
        <span class="illuminus-export-dialog__pages">{{journal.pages}}</span>
      </label>
      {{/each}}
    </div>
    {{else}}
    <p class="illuminus-manager__empty">{{localize "ILLUMINUS.Export.NoJournals"}}</p>
    {{/if}}
    <p class="illuminus-export-dialog__none hint">{{localize "ILLUMINUS.Export.NoneInStyle"}}</p>
  </fieldset>

  <fieldset>
    <legend>{{localize "ILLUMINUS.Export.FormatLegend"}}</legend>
    {{!-- The icon sits outside the label: inside it, clicking to read what a
          format does would choose that format. --}}
    {{#each formats as |format|}}
    <div class="illuminus-export-dialog__option">
      <label>
        {{#if format.checked}}
        <input type="radio" name="format" value="{{format.id}}" checked>
        {{else}}
        <input type="radio" name="format" value="{{format.id}}">
        {{/if}}
        <span>{{localize format.label}}</span>
      </label>
      <button type="button" class="illuminus-info" data-action="showHint"
              aria-label="{{localize format.note}}">
        <i class="fa-solid fa-circle-info"></i>
      </button>
      <span class="illuminus-export-dialog__hint">{{localize format.note}}</span>
    </div>
    {{/each}}
  </fieldset>

  <fieldset>
    <legend>{{localize "ILLUMINUS.Export.OptionsLegend"}}</legend>
    {{!-- Each option says what it is, and keeps why behind the icon beside it,
          as the style editor does. --}}
    {{!-- A stylesheet carries no words, so there are none to keep back. --}}
    <div class="illuminus-export-dialog__option illuminus-export-dialog__not-css">
      <label>
        <input type="checkbox" name="secrets">
        <span>{{localize "ILLUMINUS.Export.Secrets"}}</span>
      </label>
      <button type="button" class="illuminus-info" data-action="showHint"
              aria-label="{{localize 'ILLUMINUS.Export.SecretsHint'}}">
        <i class="fa-solid fa-circle-info"></i>
      </button>
      <span class="illuminus-export-dialog__hint">{{localize "ILLUMINUS.Export.SecretsHint"}}</span>
    </div>
    <div class="illuminus-export-dialog__option illuminus-export-dialog__pdf-only">
      <label>
        <input type="checkbox" name="pageBackground">
        <span>{{localize "ILLUMINUS.Export.PageTexture"}}</span>
      </label>
      <button type="button" class="illuminus-info" data-action="showHint"
              aria-label="{{localize 'ILLUMINUS.Export.PageTextureHint'}}">
        <i class="fa-solid fa-circle-info"></i>
      </button>
      <span class="illuminus-export-dialog__hint">{{localize "ILLUMINUS.Export.PageTextureHint"}}</span>
    </div>
    {{!-- Only for the stylesheet, and required there: it is what keeps the
          exported CSS from answering to the same names Illuminus does.

          Required by the submit handler rather than by the `required`
          attribute: this row is hidden for every other way of saving, and a
          browser refuses to submit a form holding an empty required field it
          cannot even focus — which stopped the export dead, with nothing said. --}}
    <div class="illuminus-export-dialog__option illuminus-export-dialog__css-only">
      <label for="illuminus-css-prefix">{{localize "ILLUMINUS.Export.CssPrefix"}}</label>
      <button type="button" class="illuminus-info" data-action="showHint"
              aria-label="{{localize 'ILLUMINUS.Export.CssPrefixHint'}}">
        <i class="fa-solid fa-circle-info"></i>
      </button>
      <input type="text" id="illuminus-css-prefix" name="cssPrefix" value="{{cssPrefix}}"
             placeholder="{{localize 'ILLUMINUS.Export.CssPrefixPlaceholder'}}">
      {{!-- Ours alone, with none of Foundry's own hint styling: that class is
            unlayered, and an unlayered rule beats a layered one however
            specific — the wording showed itself however firmly we hid it. --}}
      <span class="illuminus-export-dialog__hint">{{localize "ILLUMINUS.Export.CssPrefixHint"}}</span>
    </div>
  </fieldset>
</div>
