{{!-- A shadow or a picture: five controls that always travel together, laid out
      with each name above its own control rather than beside it, so five rows
      become one wrapped row. Every control is still its own `.illuminus-field`
      with the words it always had — what changes is the direction the name sits
      in. --}}
{{#if cluster.divider}}<hr class="illuminus-divider" aria-hidden="true">{{/if}}
<details class="illuminus-cluster" data-cluster="{{cluster.family}}" data-kind="{{cluster.kind}}"
         data-open="{{#if cluster.open}}1{{else}}0{{/if}}"
         {{#if cluster.open}}open{{/if}}>
  <summary class="illuminus-cluster__summary">
    {{!-- Which of them this is, where a category holds more than one. Where it
          holds only one, the category has said so already and the run's own
          name carries it. --}}
    <span class="illuminus-cluster__name">{{#if cluster.name}}{{cluster.name}}{{else}}{{cluster.plainName}}{{/if}}</span>
    {{> "modules/illuminus/templates/style-run-says.hbs" says=cluster}}
  </summary>
  <div class="illuminus-cluster__cells">
  {{#each cluster.fields as |field|}}
  <div class="illuminus-cluster__cell">
    {{> "modules/illuminus/templates/style-field.hbs" field=field}}
  </div>
  {{/each}}
  </div>
</details>
