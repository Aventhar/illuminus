<div class="illuminus-editor__layout">
  {{!-- Spans the window above both columns: a search that only looked in the
        open part would not answer "which part has the shadow settings?" --}}
  <div class="illuminus-filter">
    <i class="fa-solid fa-magnifying-glass"></i>
    <input type="search" class="illuminus-filter__input" autocomplete="off"
           placeholder="{{localize 'ILLUMINUS.Editor.FilterPlaceholder'}}"
           aria-label="{{localize 'ILLUMINUS.Editor.FilterPlaceholder'}}">
    <span class="illuminus-filter__count" aria-live="polite"></span>
    {{!-- Reading back what a style actually says is the other question this bar
          answers, and at two thousand controls it cannot be answered by
          scrolling. --}}
    <label class="illuminus-filter__set">
      <input type="checkbox" class="illuminus-filter__set-box">
      {{localize "ILLUMINUS.Editor.OnlySet"}}
    </label>
  </div>

  <div class="illuminus-editor__columns">

  {{!-- The parts of a journal, as they hold one another: the window holds the
        page, the page holds its headings and its boxes. A strip of parts could
        not say that — a heading and the window frame sat side by side as though
        they were the same kind of thing. --}}
  {{!-- Core's own changeTab finds a pane through `.tabs [data-group][data-tab]`,
        and its styling for that class is unlayered — worn by the tree it reached
        every row and drew each one as a button. The class lives on an anchor
        that exists only to be found, so the tree is styled by this module
        alone. --}}
  <nav class="tabs illuminus-tree__anchor" hidden aria-hidden="true">
    {{#each partIds as |id|}}<span data-group="sheet" data-tab="{{id}}"></span>{{/each}}
  </nav>

  <nav class="illuminus-tree" aria-label="{{localize 'ILLUMINUS.Editor.PartsLabel'}}">
    {{!-- Open every branch at once, or shut them. The tree is sixteen parts
          deep in places, and reaching one of a treatment's ten members meant
          twisting two branches open every time the window was opened. --}}
    <div class="illuminus-tree__tools">
      <button type="button" class="illuminus-fold-all" data-action="foldTree"
              data-tooltip="{{localize 'ILLUMINUS.Editor.UnfoldAll'}}"
              aria-label="{{localize 'ILLUMINUS.Editor.UnfoldAll'}}">
        <i class="fa-solid fa-angles-down"></i>
      </button>
    </div>
    {{> "modules/illuminus/templates/style-tree-branch.hbs" nodes=tree}}
  </nav>

  {{#each groups as |group|}}
  <section class="tab illuminus-part {{#if group.active}}active{{/if}}" data-group="sheet" data-tab="{{group.id}}">

    <div class="illuminus-part__tools">
      <h3 class="illuminus-part__name">{{group.label}}</h3>
      {{!-- Every category on this part, and every run inside them. --}}
      <button type="button" class="illuminus-fold-all" data-action="foldPart"
              data-tooltip="{{localize 'ILLUMINUS.Editor.UnfoldAll'}}"
              aria-label="{{localize 'ILLUMINUS.Editor.UnfoldAll'}}">
        <i class="fa-solid fa-angles-down"></i>
      </button>
      <button type="button" class="illuminus-reset" data-action="resetGroup"
              data-tooltip="{{localize 'ILLUMINUS.Buttons.ResetGroupTooltip'}}">
        <i class="fa-solid fa-rotate-left"></i>
        {{localize "ILLUMINUS.Buttons.ResetGroup"}}
      </button>
      <button type="button" class="illuminus-reset" data-action="resetAll"
              data-tooltip="{{localize 'ILLUMINUS.Buttons.ResetAllTooltip'}}">
        <i class="fa-solid fa-broom"></i>
        {{localize "ILLUMINUS.Buttons.ResetAll"}}
      </button>
    </div>

    <header class="illuminus-part__head">
      {{!-- Behind an icon like every other explanation. It stays in the markup
            for the search box, and at a narrow settings column a paragraph
            here pushed the first control most of the way down the pane. --}}
      <p class="hint illuminus-part__hint">{{group.hint}}</p>
      <button type="button" class="illuminus-info" data-action="showHint"
              aria-label="{{group.hint}}">
        <i class="fa-solid fa-circle-info"></i>
      </button>

      {{#if group.plainReset}}
      <button type="button" class="illuminus-reset" data-action="foundryDefault"
              data-tooltip="{{localize 'ILLUMINUS.Buttons.FoundryDefaultTooltip'}}">
        <i class="fa-solid fa-rotate-left"></i>
        {{localize "ILLUMINUS.Buttons.FoundryDefault"}}
      </button>
      {{/if}}
    </header>

    <div class="illuminus-fields scrollable">
      {{#each group.sections as |section|}}
      {{!-- A category does not fold. The runs inside it do — a category is where
            you are, and folding the place you are standing only ever hid the
            controls you had come for. Its name and the answers that apply to the
            whole of it are one block, held against the top of the settings while
            the controls scroll past. --}}
      <section class="illuminus-section">
        <header class="illuminus-section__head" data-group="{{group.id}}" data-section="{{section.id}}">
          <div class="illuminus-section__name">
            <span class="illuminus-section__label">{{section.label}}</span>
            <button type="button" class="illuminus-info" data-action="showHint"
                    aria-label="{{section.hint}}">
              <i class="fa-solid fa-circle-info"></i>
            </button>
            <span class="illuminus-section__hint">{{section.hint}}</span>
          </div>

        <div class="illuminus-section__tools">
          {{#if section.matchable}}
          <button type="button" class="illuminus-reset" data-action="matchSides"
                  data-group="{{group.id}}" data-section="{{section.id}}"
                  data-tooltip="{{localize 'ILLUMINUS.Buttons.MatchSidesTooltip'}}">
            <i class="fa-solid fa-link"></i>
            {{localize "ILLUMINUS.Buttons.MatchSides"}}
          </button>
          {{/if}}
          {{#if section.copyFrom}}
          <button type="button" class="illuminus-reset" data-action="copyFromPart"
                  data-group="{{group.id}}" data-section="{{section.id}}"
                  data-from="{{section.copyFrom.group}}"
                  data-tooltip="{{localize 'ILLUMINUS.Buttons.CopyFromPartTooltip' part=section.copyFrom.label}}">
            <i class="fa-solid fa-clone"></i>
            {{localize "ILLUMINUS.Buttons.CopyFromPart" part=section.copyFrom.label}}
          </button>
          {{/if}}
          <button type="button" class="illuminus-reset" data-action="resetSection"
                  data-group="{{group.id}}" data-section="{{section.id}}"
                  data-tooltip="{{localize 'ILLUMINUS.Buttons.ResetSectionTooltip'}}">
            <i class="fa-solid fa-rotate-left"></i>
            {{localize "ILLUMINUS.Buttons.ResetSection"}}
          </button>
        </div>

        {{!-- A line above the first control and below the last, so a category
              reads as a block of its own rather than running into the one
              beneath it. The ones between the runs are written by the schema. --}}
        </header>

        <hr class="illuminus-divider illuminus-divider--edge" aria-hidden="true">
        {{#each section.rows as |row|}}
        {{#if row.box}}
        {{> "modules/illuminus/templates/style-box.hbs" box=row.box}}
        {{else if row.cluster}}
        {{> "modules/illuminus/templates/style-cluster.hbs" cluster=row.cluster}}
        {{else if row.run}}
        {{> "modules/illuminus/templates/style-run.hbs" run=row.run}}
        {{else}}
        {{> "modules/illuminus/templates/style-field.hbs" field=row.field}}
        {{/if}}
        {{/each}}
        <hr class="illuminus-divider illuminus-divider--edge" aria-hidden="true">
      </section>
      {{/each}}
    </div>
  </section>
  {{/each}}

  {{#each families as |family|}}
  <section class="tab illuminus-part {{#if family.active}}active{{/if}}" data-group="sheet" data-tab="{{family.id}}">

    <div class="illuminus-part__tools">
      <h3 class="illuminus-part__name">{{family.current.label}}</h3>
      {{!-- Every category on this part, and every run inside them. --}}
      <button type="button" class="illuminus-fold-all" data-action="foldPart"
              data-tooltip="{{localize 'ILLUMINUS.Editor.UnfoldAll'}}"
              aria-label="{{localize 'ILLUMINUS.Editor.UnfoldAll'}}">
        <i class="fa-solid fa-angles-down"></i>
      </button>
      <button type="button" class="illuminus-reset" data-action="resetGroup"
              data-tooltip="{{localize 'ILLUMINUS.Buttons.ResetGroupTooltip'}}">
        <i class="fa-solid fa-rotate-left"></i>
        {{localize "ILLUMINUS.Buttons.ResetGroup"}}
      </button>
      <button type="button" class="illuminus-reset" data-action="resetAll"
              data-tooltip="{{localize 'ILLUMINUS.Buttons.ResetAllTooltip'}}">
        <i class="fa-solid fa-broom"></i>
        {{localize "ILLUMINUS.Buttons.ResetAll"}}
      </button>
    </div>

    <header class="illuminus-part__head illuminus-family__head">
      <select data-family-picker="{{family.id}}" aria-label="{{family.nameLabel}}">
        {{#each family.members as |member|}}
        <option value="{{member.id}}" {{#if member.selected}}selected{{/if}}>{{member.label}}</option>
        {{/each}}
      </select>
      {{#if family.copyFrom}}
      <button type="button" class="illuminus-reset" data-action="copyFromAbove"
              data-group="{{family.copyFrom.id}}" data-into="{{family.current.id}}"
              data-tooltip="{{localize 'ILLUMINUS.Buttons.CopyFromTooltip'}}">
        <i class="fa-solid fa-copy"></i>
        {{localize "ILLUMINUS.Buttons.CopyFrom" name=family.copyFrom.label}}
      </button>
      {{/if}}
      {{#if family.renamable}}
      <input type="text" class="illuminus-family__name" data-rename="{{family.current.id}}"
             value="{{family.current.label}}" placeholder="{{family.nameLabel}}"
             aria-label="{{family.nameLabel}}">
      <button type="button" class="illuminus-reset" data-action="renameMember" data-group="{{family.current.id}}">
        <i class="fa-solid fa-check"></i>
        {{localize "ILLUMINUS.Buttons.Rename"}}
      </button>
      {{/if}}
    </header>

    <p class="hint">{{family.hint}}</p>

    <div class="illuminus-fields scrollable">
      {{#each family.current.sections as |section|}}
      {{!-- A category does not fold. The runs inside it do — a category is where
            you are, and folding the place you are standing only ever hid the
            controls you had come for. Its name and the answers that apply to the
            whole of it are one block, held against the top of the settings while
            the controls scroll past. --}}
      <section class="illuminus-section">
        <header class="illuminus-section__head" data-group="{{family.current.id}}" data-section="{{section.id}}">
          <div class="illuminus-section__name">
            <span class="illuminus-section__label">{{section.label}}</span>
            <button type="button" class="illuminus-info" data-action="showHint"
                    aria-label="{{section.hint}}">
              <i class="fa-solid fa-circle-info"></i>
            </button>
            <span class="illuminus-section__hint">{{section.hint}}</span>
          </div>

        <div class="illuminus-section__tools">
          {{#if section.matchable}}
          <button type="button" class="illuminus-reset" data-action="matchSides"
                  data-group="{{family.current.id}}" data-section="{{section.id}}"
                  data-tooltip="{{localize 'ILLUMINUS.Buttons.MatchSidesTooltip'}}">
            <i class="fa-solid fa-link"></i>
            {{localize "ILLUMINUS.Buttons.MatchSides"}}
          </button>
          {{/if}}
          {{#if section.copyFrom}}
          <button type="button" class="illuminus-reset" data-action="copyFromPart"
                  data-group="{{family.current.id}}" data-section="{{section.id}}"
                  data-from="{{section.copyFrom.group}}"
                  data-tooltip="{{localize 'ILLUMINUS.Buttons.CopyFromPartTooltip' part=section.copyFrom.label}}">
            <i class="fa-solid fa-clone"></i>
            {{localize "ILLUMINUS.Buttons.CopyFromPart" part=section.copyFrom.label}}
          </button>
          {{/if}}
          <button type="button" class="illuminus-reset" data-action="resetSection"
                  data-group="{{family.current.id}}" data-section="{{section.id}}"
                  data-tooltip="{{localize 'ILLUMINUS.Buttons.ResetSectionTooltip'}}">
            <i class="fa-solid fa-rotate-left"></i>
            {{localize "ILLUMINUS.Buttons.ResetSection"}}
          </button>
        </div>

        {{!-- A line above the first control and below the last, so a category
              reads as a block of its own rather than running into the one
              beneath it. The ones between the runs are written by the schema. --}}
        </header>

        <hr class="illuminus-divider illuminus-divider--edge" aria-hidden="true">
        {{#each section.rows as |row|}}
        {{#if row.box}}
        {{> "modules/illuminus/templates/style-box.hbs" box=row.box}}
        {{else if row.cluster}}
        {{> "modules/illuminus/templates/style-cluster.hbs" cluster=row.cluster}}
        {{else if row.run}}
        {{> "modules/illuminus/templates/style-run.hbs" run=row.run}}
        {{else}}
        {{> "modules/illuminus/templates/style-field.hbs" field=row.field}}
        {{/if}}
        {{/each}}
        <hr class="illuminus-divider illuminus-divider--edge" aria-hidden="true">
      </section>
      {{/each}}
    </div>
  </section>
  {{/each}}

  <aside class="illuminus-preview">
    {{!-- Drag to give the sample more room, or hand it back to the controls. --}}
    <div class="illuminus-preview__grip" role="separator" aria-orientation="vertical"
         aria-label="{{localize 'ILLUMINUS.Editor.ResizePreview'}}"
         data-tooltip="{{localize 'ILLUMINUS.Editor.ResizePreview'}}"></div>
    <header class="illuminus-preview__head">
      <h4>{{localize "ILLUMINUS.Editor.PreviewTitle"}}</h4>
      {{!-- How large the sample is drawn. It changes nothing about the style —
            it is a magnifying glass held over the sample, so that a hairline
            border or a drop cap's outline can be judged without leaning in. --}}
      <label class="illuminus-preview__zoom">
        <i class="fa-solid fa-magnifying-glass"></i>
        <span class="illuminus-preview__zoom-label">{{localize "ILLUMINUS.Editor.Zoom"}}</span>
        {{!-- 75 to start with, which is the scale the sample was always drawn
              at, and 100 is now life size — the same size the journal itself is
              drawn at, so a setting can be judged against the real thing rather
              than against a smaller copy of it. --}}
        <input type="range" min="25" max="200" step="5" value="75"
               aria-label="{{localize 'ILLUMINUS.Editor.Zoom'}}">
        <output class="illuminus-preview__zoom-read">75%</output>
      </label>
      {{!-- The sample answers the pointer the way a real journal does, which is
            useful for judging a hovered color and a nuisance the rest of the
            time — every stray pass of the mouse repaints something. Off by
            default; clicking a piece to jump to its settings still works. --}}
      <label class="illuminus-preview__quiet"
             data-tooltip="{{localize 'ILLUMINUS.Editor.QuietSampleHint'}}">
        <input type="checkbox" class="illuminus-preview__quiet-box" checked>
        <span>{{localize "ILLUMINUS.Editor.QuietSample"}}</span>
      </label>
    </header>

    {{!-- Mirrors the journal sheet DOM so the compiled rules apply here unchanged. --}}
    {{!-- `expanded` sits here as it sits on a journal's own root: a rule written
          for a folded panel is `:not(.expanded)`, and without it here that rule
          matched the sample every moment of its life. The editor takes it off
          when somebody asks to see the folded state. --}}
    <div class="{{styledClass}} illuminus-preview__frame expanded" {{styleAttr}}="{{styleId}}">
      {{!-- Foundry's own classes for a journal window, so that every rule core
            writes for one applies to the sample as well. Core scopes its
            journal styling to `.sheet.journal-entry.application`, and the sample
            was not inside one — so anything stated there was simply absent (a
            category row 30 pixels tall against a journal's 48, a listed page's
            name at 17.5 against 32) and every control that defers with
            `revert-layer` handed its element back to nobody rather than to
            Foundry. `expanded` because core hides a listed page's title without
            it. The stylesheet takes `.application`'s own placement back out
            below: it is written for a floating window and this is a piece of
            one, drawn in the flow of the pane. --}}
      <div class="illuminus-preview__window sheet journal-entry application expanded">
      <header class="window-header" data-part="window">
        <h1 class="window-title">{{localize "ILLUMINUS.Preview.WindowTitle"}}</h1>
        <button type="button" class="header-control icon fa-solid fa-palette" disabled></button>
        <button type="button" class="header-control icon fa-solid fa-xmark" disabled></button>
      </header>
      <div class="illuminus-preview__sheet">
      {{!-- The panel, and the parts it holds. Each piece names the part that
            styles it rather than leaving them all to the panel: a part with no
            piece of its own dims nothing and scrolls to nothing, so opening
            Page Entries showed the whole journal exactly as the default does.
            The pieces nest, which the dimming already allows for — neither what
            holds the focused piece nor what it holds is dimmed. --}}
      <aside class="sidebar journal-sidebar flexcol" data-part="sidebar">
        {{!-- Foundry's own search row, small controls and all: a lock, the
              view mode, the search mode, the box itself, and the button that
              folds the panel away. The Panel Buttons part styles every button
              in here, so a row holding only the box left most of that part
              with nothing whatever to show. --}}
        <search data-part="sidebarSearch">
          <button type="button" class="inline-control lock-mode icon fa-solid fa-lock-open"
                  data-part="sidebarButtons" disabled></button>
          <button type="button" class="inline-control view-mode icon fas fa-note"
                  data-part="sidebarButtons" disabled></button>
          <button type="button" class="inline-control toggle-search-mode icon fa-solid fa-magnifying-glass"
                  data-part="sidebarButtons" disabled></button>
          <input type="search" placeholder="{{localize 'ILLUMINUS.Preview.Search'}}" disabled>
          <button type="button" class="inline-control collapse-toggle icon fas fa-caret-right"
                  data-part="sidebarButtons" disabled></button>
        </search>
        <nav class="toc">
          <ol>
            <li class="category" data-part="sidebarCategories"><strong>{{localize "ILLUMINUS.Preview.Category"}}</strong></li>
            <li class="page active" data-part="sidebarEntries">
              <div class="page-heading">
                <span class="page-index" data-part="sidebarNumbers">1</span>
                <span class="page-title ellipsis">{{localize "ILLUMINUS.Preview.CurrentPage"}}</span>
              </div>
              <ol class="headings" data-part="sidebarHeadings">
                {{!-- Marked as the one a reader chose, so the panel's Selected
                      controls have something to show. --}}
                <li class="heading h2 illuminus-current"><a class="heading-link ellipsis">{{localize "ILLUMINUS.Preview.SubHeading"}}</a></li>
                <li class="heading h3"><a class="heading-link ellipsis">{{localize "ILLUMINUS.Preview.SubHeading"}}</a></li>
              </ol>
            </li>
            <li class="page" data-part="sidebarEntries">
              <div class="page-heading">
                <span class="page-index" data-part="sidebarNumbers">2</span>
                <span class="page-title ellipsis">{{localize "ILLUMINUS.Preview.PageEntry"}}</span>
              </div>
            </li>
          </ol>
        </nav>
        {{!-- Three buttons, as Foundry draws them: a chevron either side of the
              one that makes a page. Foundry paints them two ways from one rule
              of ours — the chevrons opaque and Create at half strength — which
              a single button could not show. --}}
        <footer class="action-buttons flexrow" data-part="sidebarButtons">
          <button type="button" class="previous icon fas fa-chevron-left" disabled></button>
          <button type="button" class="create" disabled>
            <i class="fas fa-file-circle-plus" inert></i>
            <span>{{localize "ILLUMINUS.Preview.Button"}}</span>
          </button>
          <button type="button" class="next icon fas fa-chevron-right" disabled></button>
        </footer>
      </aside>

      {{!-- The page's own surface, so opening the Page part lights something
            rather than dimming everything the page contains. --}}
      <section class="journal-entry-content" data-part="page">
        <header class="journal-header" data-part="title">
          <div class="title">{{localize "ILLUMINUS.Preview.JournalTitle"}}</div>
        </header>
        <div class="journal-entry-pages">
          <article class="journal-entry-page text">
            <div>
              <header class="journal-page-header">
                <h1 data-part="heading1">{{localize "ILLUMINUS.Preview.Heading1"}}</h1>
              </header>
              {{!-- The page's contents live in their own file, because the
                    sample journal the style library builds is made of exactly
                    this markup. --}}
              <section class="journal-page-content">
                {{> "modules/illuminus/templates/sample-page.hbs"}}
              </section>
            </div>
            <div class="edit-container">
              <button type="button" class="icon fa-solid fa-edit" disabled></button>
            </div>
          </article>
        </div>
      </section>
      </div>
      </div>

      {{!-- The window Edit Page opens, so the Journal Editor part has something
            to look at. It carries the classes the real one does, because the
            rules are scoped to them: an `.application` that is also a
            `.journal-entry-page`, a title bar with its buttons, the row of
            editing controls, and a line of prose on the page's own surface.

            Written as a plain element rather than as a `prose-mirror`: that is
            a custom element, and putting one here would start an editor in the
            sample. --}}
      {{!-- Not marked as styled itself: the skeleton declares every default on
            `.illuminus-styled`, so a second one inside the frame would shadow
            the values the frame is carrying. The editor's rules name this piece
            instead. --}}
      <div class="illuminus-preview__editor application sheet journal-sheet journal-entry-page"
           data-part="editor">
        <header class="window-header">
          <h1 class="window-title">{{localize "ILLUMINUS.Preview.EditorTitle"}}</h1>
          <button type="button" class="header-control icon fa-solid fa-book" disabled></button>
          <button type="button" class="header-control icon fa-solid fa-xmark" disabled></button>
        </header>
        <section class="window-content">
          {{!-- What a page is called, and the settings beside it: the name is the
                Title part's own control, and the two settings have a category of
                their own on this part. --}}
          <header class="journal-header">
            <input class="title" type="text" value="{{localize "ILLUMINUS.Preview.EditorPageName"}}" disabled>
            <div class="page-metadata flexrow" data-part="editorSettingsBar">
              <div class="heading-level flexrow">
                <label class="flex0 fa-solid fa-list-tree"></label>
                <select disabled>
                  <option>{{localize "ILLUMINUS.Preview.EditorLevel"}}</option>
                </select>
              </div>
              <div class="show-title noflex">
                <label class="checkbox">
                  {{localize "ILLUMINUS.Preview.EditorShowTitle"}}
                  <input type="checkbox" checked disabled>
                </label>
              </div>
            </div>
          </header>
          <div class="journal-page-content editor prosemirror active illuminus-preview__prose">
            <menu class="editor-menu" data-part="editorToolbar">
              <button type="button" class="pm-dropdown" data-part="editorDropdowns" disabled>{{localize "ILLUMINUS.Preview.EditorFormat"}}</button>
              <button type="button" class="pm-dropdown" data-part="editorDropdowns" disabled>{{localize "ILLUMINUS.Preview.EditorIlluminus"}}</button>
              <button type="button" class="icon fa-solid fa-bold" disabled></button>
              <button type="button" class="icon fa-solid fa-italic" disabled></button>
              <button type="button" class="icon fa-solid fa-link" disabled></button>
            </menu>
            <div class="editor-content ProseMirror">
              <p>{{localize "ILLUMINUS.Preview.EditorBody"}}</p>
            </div>
          </div>
        </section>
      </div>

      {{!-- Block Styles and Picture Styles take the pane over: a block is only
            legible next to the prose it interrupts, and the full journal mock
            would leave it a sliver of the width. --}}
      <div class="illuminus-preview__family" data-family="boxStyles">
        <section class="journal-entry-content">
          <div class="journal-entry-pages">
            <article class="journal-entry-page text">
              <section class="journal-page-content">
                <blockquote class="illuminus-box illuminus-box--{{preview.boxStyles.id}}">
                  <h2>{{localize "ILLUMINUS.Preview.BlockHeading"}}</h2>
                  <p>{{localize "ILLUMINUS.Preview.BlockBody"}}</p>
                </blockquote>
                <p>{{localize "ILLUMINUS.Preview.Flow"}}</p>
                <p>{{localize "ILLUMINUS.Preview.Flow"}}</p>
              </section>
            </article>
          </div>
        </section>
      </div>

      <div class="illuminus-preview__family" data-family="tagStyles">
        <section class="journal-entry-content">
          <div class="journal-entry-pages">
            <article class="journal-entry-page text">
              <section class="journal-page-content">
                {{!-- A title line and a row of tags: the two things inline
                      treatments exist for, both built from the same tag. --}}
                <h2>{{localize "ILLUMINUS.Preview.TagTitle"}}
                  <span class="illuminus-tag illuminus-tag--{{preview.tagStyles.id}}"
                        >{{localize "ILLUMINUS.Preview.TagRank"}}</span></h2>
                <p><span class="illuminus-tag illuminus-tag--{{preview.tagStyles.id}}">{{localize "ILLUMINUS.Preview.TagOne"}}</span
                  ><span class="illuminus-tag illuminus-tag--{{preview.tagStyles.id}}">{{localize "ILLUMINUS.Preview.TagTwo"}}</span
