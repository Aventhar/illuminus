<div class="illuminus-editor__layout">

  {{#each groups as |group|}}
  <section class="tab illuminus-tab {{#if group.active}}active{{/if}}" data-group="sheet" data-tab="{{group.id}}">

    <header class="illuminus-tab__head">
      <p class="hint">{{group.hint}}</p>
      <button type="button" class="illuminus-reset" data-action="resetGroup" data-group="{{group.id}}"
              data-tooltip="{{localize 'ILLUMINUS.Buttons.ResetGroupTooltip'}}">
        <i class="fa-solid fa-rotate-left"></i>
        {{localize "ILLUMINUS.Buttons.ResetGroup"}}
      </button>
    </header>

    <div class="illuminus-fields scrollable">
      {{#each group.sections as |section|}}
      <details class="illuminus-section" {{#if section.open}}open{{/if}}>
        <summary data-action="toggleSection" data-group="{{group.id}}" data-section="{{section.id}}">
          <span class="illuminus-section__label">{{section.label}}</span>
          <span class="illuminus-section__hint">{{section.hint}}</span>
        </summary>

        <div class="illuminus-section__tools">
          {{#if section.matchable}}
          <button type="button" class="illuminus-reset" data-action="matchSides"
                  data-group="{{group.id}}" data-section="{{section.id}}"
                  data-tooltip="{{localize 'ILLUMINUS.Buttons.MatchSidesTooltip'}}">
            <i class="fa-solid fa-link"></i>
            {{localize "ILLUMINUS.Buttons.MatchSides"}}
          </button>
          {{/if}}
          <button type="button" class="illuminus-reset" data-action="resetSection"
                  data-group="{{group.id}}" data-section="{{section.id}}"
                  data-tooltip="{{localize 'ILLUMINUS.Buttons.ResetSectionTooltip'}}">
            <i class="fa-solid fa-rotate-left"></i>
            {{localize "ILLUMINUS.Buttons.ResetSection"}}
          </button>
        </div>

        {{#each section.fields as |field|}}
        <div class="illuminus-field {{#if field.isDefault}}is-default{{/if}}" data-field="{{field.path}}">
          <label for="illuminus-{{field.path}}">
            <span class="illuminus-field__label">{{field.label}}</span>
            <span class="illuminus-field__hint">{{field.hint}}</span>
          </label>

          <div class="illuminus-field__control">
            {{#if (eq field.type "color")}}
              <color-picker id="illuminus-{{field.path}}" name="{{field.path}}" value="{{field.value}}"></color-picker>
              {{!-- Removed at render time when the browser has no EyeDropper API. --}}
              <button type="button" class="illuminus-eyedropper" data-action="pickColor" data-path="{{field.path}}"
                      data-tooltip="{{localize 'ILLUMINUS.Buttons.PickColorTooltip'}}"
                      aria-label="{{localize 'ILLUMINUS.Buttons.PickColor'}}">
                <i class="fa-solid fa-eye-dropper"></i>
              </button>

            {{else if (eq field.type "image")}}
              <file-picker id="illuminus-{{field.path}}" name="{{field.path}}" type="image"
                           value="{{field.value}}" placeholder="{{localize 'ILLUMINUS.Field.texture.placeholder'}}"></file-picker>

            {{else if (eq field.type "number")}}
              <range-picker id="illuminus-{{field.path}}" name="{{field.path}}" value="{{field.value}}"
                            min="{{field.min}}" max="{{field.max}}" step="{{field.step}}"></range-picker>
              {{#if field.unit}}<span class="illuminus-unit">{{field.unit}}</span>{{/if}}

            {{else if (eq field.type "toggle")}}
              <input type="checkbox" id="illuminus-{{field.path}}" name="{{field.path}}"
                     data-dtype="Boolean" {{checked field.checked}}>

            {{else}}
              <select id="illuminus-{{field.path}}" name="{{field.path}}">
                {{#each field.choices as |choice|}}
                <option value="{{choice.value}}" {{#if choice.selected}}selected{{/if}}>{{choice.label}}</option>
                {{/each}}
              </select>
            {{/if}}
          </div>
        </div>
        {{/each}}
      </details>
      {{/each}}
    </div>
  </section>
  {{/each}}

  <aside class="illuminus-preview">
    <header class="illuminus-preview__head">
      <h4>{{localize "ILLUMINUS.Editor.PreviewTitle"}}</h4>
      <button type="button" class="illuminus-reset" data-action="resetAll"
              data-tooltip="{{localize 'ILLUMINUS.Buttons.ResetAllTooltip'}}">
        <i class="fa-solid fa-broom"></i>
        {{localize "ILLUMINUS.Buttons.ResetAll"}}
      </button>
    </header>

    {{!-- Mirrors the journal sheet DOM so the compiled rules apply here unchanged. --}}
    <div class="{{styledClass}} illuminus-preview__frame" {{styleAttr}}="{{styleId}}">
      <div class="illuminus-preview__window">
      <header class="window-header">
        <h1 class="window-title">{{localize "ILLUMINUS.Preview.WindowTitle"}}</h1>
        <button type="button" class="header-control icon fa-solid fa-palette" disabled></button>
        <button type="button" class="header-control icon fa-solid fa-xmark" disabled></button>
      </header>
      <div class="illuminus-preview__sheet">
      <aside class="sidebar journal-sidebar flexcol">
        <search>
          <input type="search" placeholder="{{localize 'ILLUMINUS.Preview.Search'}}" disabled>
        </search>
        <nav class="toc">
          <ol>
            <li class="category"><strong>{{localize "ILLUMINUS.Preview.Category"}}</strong></li>
            <li class="page active">
              <div class="page-heading">
                <span class="page-index">1</span>
                <span class="page-title ellipsis">{{localize "ILLUMINUS.Preview.CurrentPage"}}</span>
              </div>
              <ol class="headings">
                <li class="heading h2"><a class="heading-link ellipsis">{{localize "ILLUMINUS.Preview.SubHeading"}}</a></li>
                <li class="heading h3"><a class="heading-link ellipsis">{{localize "ILLUMINUS.Preview.SubHeading"}}</a></li>
              </ol>
            </li>
            <li class="page">
              <div class="page-heading">
                <span class="page-index">2</span>
                <span class="page-title ellipsis">{{localize "ILLUMINUS.Preview.PageEntry"}}</span>
              </div>
            </li>
          </ol>
        </nav>
        <footer class="action-buttons flexrow">
          <button type="button" disabled>{{localize "ILLUMINUS.Preview.Button"}}</button>
        </footer>
      </aside>

      <section class="journal-entry-content">
        <header class="journal-header">
          <div class="title">{{localize "ILLUMINUS.Preview.JournalTitle"}}</div>
        </header>
        <div class="journal-entry-pages">
          <article class="journal-entry-page text">
            <div>
              <header class="journal-page-header">
                <h1>{{localize "ILLUMINUS.Preview.Heading1"}}</h1>
              </header>
              <section class="journal-page-content">
                <p>{{localize "ILLUMINUS.Preview.Body"}}
                  <a class="content-link">{{localize "ILLUMINUS.Preview.Link"}}</a>.</p>
                <h2>{{localize "ILLUMINUS.Preview.Heading2"}}</h2>
                <blockquote><p>{{localize "ILLUMINUS.Preview.Boxed"}}</p></blockquote>
                <h3>{{localize "ILLUMINUS.Preview.Heading3"}}</h3>
                <ul>
                  <li>{{localize "ILLUMINUS.Preview.ListItem"}}</li>
                  <li>{{localize "ILLUMINUS.Preview.ListItem"}}</li>
                </ul>
                <table>
                  <thead>
                    <tr>
                      <th>{{localize "ILLUMINUS.Preview.TableHeader"}}</th>
                      <th>{{localize "ILLUMINUS.Preview.TableHeader"}}</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr><td>{{localize "ILLUMINUS.Preview.TableCell"}}</td><td>{{localize "ILLUMINUS.Preview.TableCell"}}</td></tr>
                    <tr><td>{{localize "ILLUMINUS.Preview.TableCell"}}</td><td>{{localize "ILLUMINUS.Preview.TableCell"}}</td></tr>
                  </tbody>
                </table>
                <figure>
                  <img src="modules/illuminus/assets/Samples/Pictures/castle.jpg"
                       alt="{{localize 'ILLUMINUS.Preview.Caption'}}">
                  <figcaption>{{localize "ILLUMINUS.Preview.Caption"}}</figcaption>
                </figure>
              </section>
            </div>
            <div class="edit-container">
              <button type="button" class="icon fa-solid fa-edit" disabled></button>
            </div>
          </article>
        </div>
      </section>
      </div>
      </div>
    </div>
  </aside>

</div>
