{{!-- One box family — an edge, its corners, and the space inside and outside it
      — gathered into four runs instead of twenty-four rows.

      Every control is still its own `.illuminus-field`, because the state
      switch, the filter, the changed markers and Match all sides all read the
      controls themselves. What this changes is where they are drawn: the four
      sides of a spacing sit in a cross where they belong, an edge shows the
      side that is chosen rather than all four at once, and a run the style has
      nothing to say about is folded away behind the line that says so. --}}
{{#if box.divider}}<hr class="illuminus-divider" aria-hidden="true">{{/if}}
<div class="illuminus-box" data-box="{{box.family}}">

  {{#if box.spacing.length}}
  {{#if box.lines.padding}}<hr class="illuminus-divider" aria-hidden="true">{{/if}}
  <details class="illuminus-box__run" data-run="spacing"
           data-open="{{#if box.spacingSays.open}}1{{else}}0{{/if}}"
           {{#if box.spacingSays.open}}open{{/if}}>
    <summary class="illuminus-box__summary">
      <span class="illuminus-box__name">{{localize "ILLUMINUS.Box.Spacing"}}</span>
      {{> "modules/illuminus/templates/style-run-says.hbs" says=box.spacingSays}}
    </summary>
    {{!-- The space inside a thing and the space around it, as one box: the
          inner four within it and the outer four around it, each where it
          belongs rather than eighth in a list of eight. --}}
    <div class="illuminus-box__model">
      <span class="illuminus-box__ring illuminus-box__ring--outer"
            aria-hidden="true">{{localize "ILLUMINUS.Box.Outer"}}</span>
      <span class="illuminus-box__ring illuminus-box__ring--inner"
            aria-hidden="true">{{localize "ILLUMINUS.Box.Inner"}}</span>
      {{#each box.spacing as |field|}}
      {{> "modules/illuminus/templates/style-box-cell.hbs" field=field
          place=field.side ring=field.ring}}
      {{/each}}
    </div>
  </details>
  {{/if}}

  {{#if box.edges.length}}
  {{#if box.lines.border}}<hr class="illuminus-divider" aria-hidden="true">{{/if}}
  <details class="illuminus-box__run" data-run="edges"
           data-open="{{#if box.edgesSays.open}}1{{else}}0{{/if}}"
           {{#if box.edgesSays.open}}open{{/if}}>
    <summary class="illuminus-box__summary">
      <span class="illuminus-box__name">{{localize "ILLUMINUS.Box.Edges"}}</span>
      {{> "modules/illuminus/templates/style-run-says.hbs" says=box.edgesSays}}
    </summary>

    {{!-- The box again, drawn this time with what it is drawn with: a thickness
          on each edge, a radius at each corner, and beneath it the style and
          color of whichever side is chosen. --}}
    <div class="illuminus-box__model illuminus-box__model--edges">
      <span class="illuminus-box__ring illuminus-box__ring--edge" aria-hidden="true"></span>
      {{#each box.corners as |field|}}
      {{> "modules/illuminus/templates/style-box-cell.hbs" field=field place=field.corner}}
      {{/each}}
      {{#each box.border as |field|}}
      {{#if field.onEdge}}
      {{> "modules/illuminus/templates/style-box-cell.hbs" field=field place=field.side ring="edge"}}
      {{/if}}
      {{/each}}
    </div>

    {{!-- Only where there is an edge to set: a family can have corners and no
          edge of its own, and a chooser for nothing would be a lie. --}}
    {{#if box.border.length}}
    <div class="illuminus-box__sides" role="group"
         aria-label="{{localize 'ILLUMINUS.Box.WhichSide'}}">
      <button type="button" class="illuminus-box__side is-on" data-side="Top">
        {{localize "ILLUMINUS.Box.Top"}}</button>
      <button type="button" class="illuminus-box__side" data-side="Right">
        {{localize "ILLUMINUS.Box.Right"}}</button>
      <button type="button" class="illuminus-box__side" data-side="Bottom">
        {{localize "ILLUMINUS.Box.Bottom"}}</button>
      <button type="button" class="illuminus-box__side" data-side="Left">
        {{localize "ILLUMINUS.Box.Left"}}</button>
    </div>
    <div class="illuminus-box__edge">
      {{#each box.border as |field|}}
      {{#unless field.onEdge}}
      <div class="illuminus-box__part" data-side="{{field.side}}" data-part="{{field.part}}">
        {{> "modules/illuminus/templates/style-field.hbs" field=field}}
      </div>
      {{/unless}}
      {{/each}}
    </div>
    {{/if}}

    {{!-- What those four corners are cut to, under the box they turn. --}}
    {{#if box.cornerShape}}
    <div class="illuminus-box__shape">
      {{> "modules/illuminus/templates/style-field.hbs" field=box.cornerShape}}
    </div>
    {{/if}}
  </details>
  {{/if}}

</div>
