{
  "id": "illuminus",
  "title": "Illuminus",
  "description": "Decorative styling for Foundry journals, applied per journal and configured entirely through a plain-language GUI. 570 controls across 13 tabs covering the page and the contents sidebar \u2014 every border side, corner, and shadow component set independently. Build looks like those in professionally produced adventures, then export them to share between worlds.",
  "version": "0.9.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14.367"
  },
  "authors": [
    {
      "name": "Aventhar",
      "url": "https://github.com/Aventhar"
    }
  ],
  "esmodules": [
    "scripts/module.mjs"
  ],
  "styles": [
    "styles/illuminus.css",
    "styles/illuminus-generated.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "socket": false,
  "url": "https://github.com/Aventhar/illuminus",
  "license": "https://github.com/Aventhar/illuminus/blob/main/LICENSE",
  "manifest": "https://github.com/Aventhar/illuminus/releases/latest/download/module.json",
  "download": "https://github.com/Aventhar/illuminus/releases/latest/download/module.zip",
  "readme": "https://github.com/Aventhar/illuminus/blob/main/README.md",
  "flags": {
    "hotReload": {
      "extensions": [
        "css",
        "hbs",
        "json"
      ],
      "paths": [
        "styles",
        "templates",
        "lang"
      ]
    }
  },
  "bugs": "https://github.com/Aventhar/illuminus/issues"
}
